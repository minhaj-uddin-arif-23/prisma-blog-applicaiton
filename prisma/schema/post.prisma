model Post {
    id         String     @id @default(uuid())
    title      String     @db.VarChar(225)
    thumnail   String?
    content    String     @db.Text
    isFeatured Boolean    @default(false)
    views      Int        @default(0)
    authorId   String
    tags       String[]
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    status     PostStatus @default(PUBLISHED)
    comments   Comment[]

    @@index([authorId])
    @@map("posts")
}

enum PostStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}
